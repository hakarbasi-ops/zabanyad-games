# Copy to .env on the server and fill in. Never commit .env.

# Panel password (/admin)
ADMIN_PASSWORD=

# Zabanyad discount API
DISCOUNT_API_URL=https://api.zabanyad.com/api/v1/discount/generateDiscountForUser
DISCOUNT_API_SECRET=
# live = real codes from Zabanyad; mock = fake test codes (starting with T). Default: live when a secret is set.
DISCOUNT_MODE=mock

# Where winners use their code / sign up
SHOP_URL=https://zabanyad.com
SIGNUP_URL=https://zabanyad.com

# Optional
# DATA_DIR=/var/lib/zabanyad-games
# IP_PLAYS_PER_HOUR=30
# TRUST_PROXY=1   # 1 when behind nginx/CDN (reads X-Real-IP)
