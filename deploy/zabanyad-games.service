[Unit]
Description=Zabanyad discount games
After=network.target

[Service]
User=zgames
Group=zgames
WorkingDirectory=/opt/zabanyad-games
Environment=DATA_DIR=/opt/zabanyad-games/data
# one worker: the app keeps a small in-process lock around prize draws
ExecStart=/opt/zabanyad-games/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-server-header
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
